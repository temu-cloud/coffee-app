generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model user {
  id                      String             @id
  name                    String
  email                   String             @unique
  emailVerified           Boolean
  image                   String?
  createdAt               DateTime
  updatedAt               DateTime
  role                    String             @default("NO_ROLE")
  assetCreated            Asset[]            @relation("AssetCreatedBy")
  assetUpdated            Asset[]            @relation("AssetUpdatedBy")
  budgetCreated           Budget[]           @relation("BudgetCreatedBy")
  budgetUpdated           Budget[]           @relation("BudgetUpdatedBy")
  expenseCreated          DailyExpense[]     @relation("ExpenseCreatedBy")
  expenseUpdated          DailyExpense[]     @relation("ExpenseUpdatedBy")
  saleCreated             DailySale[]        @relation("SaleCreatedBy")
  saleUpdated             DailySale[]        @relation("SaleUpdatedBy")
  inventoryHistoryCreated InventoryHistory[] @relation("InventoryHistoryCreatedBy")
  inventoryCreated        InventoryItem[]    @relation("InventoryCreatedBy")
  inventoryDeleted        InventoryItem[]    @relation("InventoryDeletedBy")
  inventoryUpdated        InventoryItem[]    @relation("InventoryUpdatedBy")
  paymentCreated          Payment[]          @relation("PaymentCreatedBy")
  paymentExecuted         Payment[]          @relation("PaymentExecutedBy")
  priceCreated            PriceHistory[]     @relation("PriceCreatedBy")
  permissions             StaffPermission?
  supplyCreated           SupplyItem[]       @relation("SupplyCreatedBy")
  supplyUpdated           SupplyItem[]       @relation("SupplyUpdatedBy")
  transactions            Transaction[]
  accounts                account[]
  sessions                session[]
}

model session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime
  user                  user      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?
}

model Product {
  id                String        @id @default(cuid())
  name              String
  category          String
  unit              String
  stock             Int           @default(0)
  lowStockThreshold Int           @default(10)
  imageUrl          String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  transactions      Transaction[]
}

model Transaction {
  id        String          @id @default(cuid())
  productId String
  userId    String
  type      TransactionType
  quantity  Int
  note      String?
  createdAt DateTime        @default(now())
  product   Product         @relation(fields: [productId], references: [id])
  user      user            @relation(fields: [userId], references: [id])

  @@index([productId])
  @@index([createdAt])
}

model StaffPermission {
  id              String  @id @default(cuid())
  userId          String  @unique
  canAddStock     Boolean @default(true)
  canUseStock     Boolean @default(true)
  canAddProducts  Boolean @default(false)
  canEditProducts Boolean @default(false)
  canViewReports  Boolean @default(false)
  user            user    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model InventoryItem {
  id          String             @id @default(cuid())
  category    ItemCategory
  date        DateTime
  name        String
  units       String
  quantity    Decimal
  unitCost    Decimal
  totalCost   Decimal
  supplier    String
  deletedAt   DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  createdById String
  updatedById String?
  deletedById String?
  sales       DailySale[]
  history     InventoryHistory[]
  createdBy   user               @relation("InventoryCreatedBy", fields: [createdById], references: [id])
  deletedBy   user?              @relation("InventoryDeletedBy", fields: [deletedById], references: [id])
  updatedBy   user?              @relation("InventoryUpdatedBy", fields: [updatedById], references: [id])
  prices      PriceHistory[]

  @@index([category])
  @@index([deletedAt])
}

model InventoryHistory {
  id              String        @id @default(cuid())
  inventoryItemId String
  date            DateTime
  quantityAdded   Decimal
  unitCost        Decimal
  totalCost       Decimal
  supplier        String
  createdAt       DateTime      @default(now())
  createdById     String
  createdBy       user          @relation("InventoryHistoryCreatedBy", fields: [createdById], references: [id])
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])

  @@index([inventoryItemId, date])
}

model SupplyItem {
  id          String   @id @default(cuid())
  date        DateTime
  name        String
  units       String
  quantity    Decimal
  unitCost    Decimal
  totalCost   Decimal
  supplier    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String
  updatedById String?
  createdBy   user     @relation("SupplyCreatedBy", fields: [createdById], references: [id])
  updatedBy   user?    @relation("SupplyUpdatedBy", fields: [updatedById], references: [id])
}

model Asset {
  id              String         @id @default(cuid())
  name            String
  category        String
  acquisitionDate DateTime
  quantity        Int
  unitCost        Decimal
  totalCost       Decimal
  condition       AssetCondition
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  createdById     String
  updatedById     String?
  createdBy       user           @relation("AssetCreatedBy", fields: [createdById], references: [id])
  updatedBy       user?          @relation("AssetUpdatedBy", fields: [updatedById], references: [id])
}

model PriceHistory {
  id              String         @id @default(cuid())
  itemName        String
  price           Decimal
  effectiveDate   DateTime
  createdAt       DateTime       @default(now())
  createdById     String
  inventoryItemId String?
  category        String         @default("OTHER")
  unitCost        Decimal?
  sales           DailySale[]
  createdBy       user           @relation("PriceCreatedBy", fields: [createdById], references: [id])
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id])

  @@index([itemName, effectiveDate])
  @@index([inventoryItemId, effectiveDate])
}

model DailySale {
  id              String         @id @default(cuid())
  date            DateTime
  itemName        String
  unitPrice       Decimal
  quantitySold    Decimal
  saleTotal       Decimal
  inventoryItemId String?
  priceHistoryId  String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  createdById     String
  updatedById     String?
  unitCost        Decimal        @default(0)
  totalCost       Decimal        @default(0)
  profit          Decimal        @default(0)
  createdBy       user           @relation("SaleCreatedBy", fields: [createdById], references: [id])
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id])
  priceHistory    PriceHistory?  @relation(fields: [priceHistoryId], references: [id])
  updatedBy       user?          @relation("SaleUpdatedBy", fields: [updatedById], references: [id])

  @@index([date])
  @@index([inventoryItemId])
}

model DailyExpense {
  id          String   @id @default(cuid())
  date        DateTime
  itemName    String
  quantity    Decimal
  unitPrice   Decimal
  totalPrice  Decimal
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String
  updatedById String?
  createdBy   user     @relation("ExpenseCreatedBy", fields: [createdById], references: [id])
  updatedBy   user?    @relation("ExpenseUpdatedBy", fields: [updatedById], references: [id])

  @@index([date])
}

model Payment {
  id            String    @id @default(cuid())
  date          DateTime
  payee         String
  description   String
  amount        Decimal
  paymentMethod String
  executedAt    DateTime?
  executedById  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  createdById   String
  createdBy     user      @relation("PaymentCreatedBy", fields: [createdById], references: [id])
  executedBy    user?     @relation("PaymentExecutedBy", fields: [executedById], references: [id])

  @@index([date])
}

model Budget {
  id              String   @id @default(cuid())
  periodMonth     Int
  periodYear      Int
  category        String
  allocatedAmount Decimal
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdById     String
  updatedById     String?
  createdBy       user     @relation("BudgetCreatedBy", fields: [createdById], references: [id])
  updatedBy       user?    @relation("BudgetUpdatedBy", fields: [updatedById], references: [id])

  @@unique([periodMonth, periodYear, category])
  @@index([periodYear, periodMonth])
}

enum TransactionType {
  STOCK_IN
  STOCK_OUT
}

enum ItemCategory {
  INGREDIENT
  FINISHED_GOOD
}

enum AssetCondition {
  EXCELLENT
  GOOD
  FAIR
  POOR
}
